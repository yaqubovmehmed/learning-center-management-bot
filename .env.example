# ===== Excellence LC bot sozlamalari =====
# Bu faylni ".env" nomi bilan nusxalab, qiymatlarni to'ldiring.
# .env faylini hech qachon GitHubga yuklamang.

# Bot token: @BotFather -> /newbot yoki /token
BOT_TOKEN=123456789:AA...

# Super admin(lar)ning Telegram ID raqami. Bir nechta bo'lsa vergul bilan.
# ID ni bilish uchun botga /whoami yozing yoki @userinfobot dan foydalaning.
SUPERADMIN_IDS=

# Birinchi ishga tushirish uchun bir martalik kod (ixtiyoriy).
# SUPERADMIN_IDS bo'sh bo'lsa, /claim KOD buyrug'i bilan super admin bo'lish mumkin.
# Kod ishlatilgandan keyin o'chirib qo'ying.
BOOTSTRAP_CODE=

# Ma'lumotlar bazasi fayli (standart: data/excellence.db)
DB_PATH=data/excellence.db

# Vaqt mintaqasi
TIMEZONE=Asia/Tashkent

# Xavfsizlik siri. Bo'sh qoldirilsa, avtomatik .secret_pepper fayli yaratiladi.
# Kamida 24 belgi. Namuna: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_PEPPER=

# Log darajasi: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Xabarlar chegarasi (spam himoyasi)
RATE_MSG_PER_MIN=30
RATE_CALLBACK_PER_MIN=60

# Haftalik hisobot (0=Dushanba ... 6=Yakshanba) va soat
DIGEST_WEEKDAY=0
DIGEST_HOUR=9

# Markaz nomi (bazadagi sozlamalar ustuvor)
CENTER_NAME=Excellence LC
